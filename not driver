<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adept Transport Inc. - Dispatch & Payment Hub</title>
    <!-- Tailwind CSS for modern responsive layout styling -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Lucide Icons for clean visual indicators -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-indigo-600 rounded-lg text-white">
                    <i data-lucide="truck" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight">Adept Transport Inc.</h1>
                    <p class="text-xs text-slate-400">Car Hauling Logistical Hub</p>
                </div>
            </div>
            <button onclick="toggleModal(true)" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-all shadow-lg shadow-indigo-600/20 cursor-pointer">
                <i data-lucide="plus" class="w-4 h-4"></i> New Order
            </button>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        
        <!-- Summary Dashboard Analytics Cards -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-xl flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-400 font-medium">Active Hauls</p>
                    <h3 id="stat-active" class="text-2xl font-bold mt-1 text-indigo-400">0</h3>
                </div>
                <div class="p-3 bg-indigo-500/10 text-indigo-400 rounded-lg"><i data-lucide="navigation"></i></div>
            </div>
            <div class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-xl flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-400 font-medium">Delivered (Unpaid)</p>
                    <h3 id="stat-delivered" class="text-2xl font-bold mt-1 text-amber-400">0</h3>
                </div>
                <div class="p-3 bg-amber-500/10 text-amber-400 rounded-lg"><i data-lucide="clock"></i></div>
            </div>
            <div class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-xl flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-400 font-medium">Outstanding Balances</p>
                    <h3 id="stat-balance" class="text-2xl font-bold mt-1 text-emerald-400">$0.00</h3>
                </div>
                <div class="p-3 bg-emerald-500/10 text-emerald-400 rounded-lg"><i data-lucide="dollar-sign"></i></div>
            </div>
            <div class="bg-slate-800/50 border border-slate-700/60 p-5 rounded-xl flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-400 font-medium">Total Vehicles Carried</p>
                    <h3 id="stat-vehicles" class="text-2xl font-bold mt-1 text-sky-400">0</h3>
                </div>
                <div class="p-3 bg-sky-500/10 text-sky-400 rounded-lg"><i data-lucide="car"></i></div>
            </div>
        </section>

        <!-- Main Workspace: Active Orders Feed -->
        <section class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <h2 class="text-xl font-bold text-slate-100 flex items-center gap-2">
                    <i data-lucide="list-ordered" class="text-indigo-400 w-5 h-5"></i> Dispatch & Payment Manifest
                </h2>
                <div class="flex flex-wrap gap-2">
                    <select id="filter-status" onchange="renderOrders()" class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-300 focus:outline-none focus:border-indigo-500 cursor-pointer">
                        <option value="All">All Haul Statuses</option>
                        <option value="Assigned">Assigned</option>
                        <option value="Picked Up">Picked Up</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <select id="filter-payment" onchange="renderOrders()" class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-300 focus:outline-none focus:border-indigo-500 cursor-pointer">
                        <option value="All">All Payment Statuses</option>
                        <option value="Unpaid">Unpaid</option>
                        <option value="Paid">Paid</option>
                        <option value="Factored">Factored</option>
                    </select>
                </div>
            </div>

            <!-- Orders Table Container -->
            <div class="bg-slate-800/40 border border-slate-800 rounded-xl overflow-hidden shadow-xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-800/80 text-slate-300 text-xs uppercase font-semibold tracking-wider border-b border-slate-700/50">
                                <th class="p-4">Order / Broker</th>
                                <th class="p-4">Route Path</th>
                                <th class="p-4">Timestamps</th>
                                <th class="p-4">Manifest Vehicles</th>
                                <th class="p-4">Gross Rate</th>
                                <th class="p-4">Haul Status</th>
                                <th class="p-4">Payment Status</th>
                                <th class="p-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody" class="divide-y divide-slate-800/60 text-sm">
                            <!-- Injected dynamically by JavaScript backend engine -->
                        </tbody>
                    </table>
                </div>
                <div id="empty-state" class="hidden p-12 text-center text-slate-500 space-y-2">
                    <i data-lucide="folder-open" class="w-12 h-12 mx-auto stroke-1"></i>
                    <p>No freight entries found matching your active filter criteria.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal Form Wrapper for Creation/Editing -->
    <div id="order-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4 transition-all">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl shadow-2xl max-h-[90vh] flex flex-col">
            <div class="p-6 border-b border-slate-800 flex items-center justify-between">
                <h3 id="modal-title" class="text-lg font-bold text-white">Create New Hauling Order</h3>
                <button onclick="toggleModal(false)" class="text-slate-400 hover:text-white transition-colors cursor-pointer"><i data-lucide="x"></i></button>
            </div>
            
            <form id="order-form" onsubmit="handleFormSubmit(event)" class="overflow-y-auto p-6 space-y-6 flex-1">
                <input type="hidden" id="edit-index">
                
                <!-- Row 1: Core Identifiers -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Order Number / Load ID</label>
                        <input type="text" id="form-id" required placeholder="e.g., BRK-88421" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Broker Company Name</label>
                        <input type="text" id="form-broker" required placeholder="e.g., Central Dispatch / Logistics Hub" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                </div>

                <!-- Row 2: Route Coordinates -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Origin Pickup Location</label>
                        <input type="text" id="form-pickup" required placeholder="City, State (e.g., Dallas, TX)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Destination Drop Location</label>
                        <input type="text" id="form-drop" required placeholder="City, State (e.g., Miami, FL)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                </div>

                <!-- Row 3: Timestamps for Pickup and Delivery -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pickup Date & Time</label>
                        <input type="datetime-local" id="form-pickup-time" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Delivery Date & Time</label>
                        <input type="datetime-local" id="form-delivery-time" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                </div>

                <!-- Row 4: Financial Rates and Base Status -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Broker Rate ($ Total)</label>
                        <input type="number" id="form-rate" step="0.01" required placeholder="0.00" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors">
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Haul Status</label>
                        <select id="form-order-status" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition-colors">
                            <option value="Assigned">Assigned</option>
                            <option value="Picked Up">Picked Up</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Payment Status</label>
                        <select id="form-payment-status" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition-colors">
                            <option value="Unpaid">Unpaid</option>
                            <option value="Paid">Paid</option>
                            <option value="Factored">Factored</option>
                        </select>
                    </div>
                </div>

                <div class="border-t border-slate-800 pt-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <h4 class="text-sm font-bold text-slate-300 flex items-center gap-2"><i data-lucide="car" class="w-4 h-4 text-indigo-400"></i> Manifest Vehicles</h4>
                        <button type="button" onclick="addVehicleInput()" class="text-xs bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 px-3 py-1.5 rounded-lg flex items-center gap-1 transition-all cursor-pointer">
                            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Add Vehicle
                        </button>
                    </div>
                    <div id="vehicles-container" class="space-y-3">
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
                    <button type="button" onclick="toggleModal(false)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 px-5 py-2.5 rounded-xl text-sm font-medium transition-colors cursor-pointer">Cancel</button>
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-xl text-sm font-semibold shadow-lg shadow-indigo-600/20 transition-all cursor-pointer">Save Order Parameters</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Seed default foundational mock data if tracking index arrays are initially blank
        let orders = JSON.parse(localStorage.getItem('adept_orders')) || [
            {
                orderNumber: "ORD-99542",
                brokerName: "Reliable Auto Logistics",
                pickup: "Dallas, TX",
                drop: "Miami, FL",
                pickupTime: "2026-03-24T08:30",
                deliveryTime: "",
                rate: 1850.00,
                orderStatus: "Picked Up",
                paymentStatus: "Unpaid",
                vehicles: [
                    { ymm: "2024 Ford F-150", operable: true },
                    { ymm: "2022 Honda Civic", operable: false }
                ]
            },
            {
                orderNumber: "ORD-73190",
                brokerName: "United Safe Haul",
                pickup: "Los Angeles, CA",
                drop: "Phoenix, AZ",
                pickupTime: "2026-03-20T10:00",
                deliveryTime: "2026-03-21T16:45",
                rate: 900.00,
                orderStatus: "Delivered",
                paymentStatus: "Factored",
                vehicles: [
                    { ymm: "2023 Tesla Model Y", operable: true }
                ]
            }
        ];

        // Global lifecycle hook on app startup initialization
        document.addEventListener("DOMContentLoaded", () => {
            renderOrders();
            lucide.createIcons();
        });

        function saveToStorage() {
            localStorage.setItem('adept_orders', JSON.stringify(orders));
            updateMetrics();
        }

        function quickUpdatePaymentStatus(index, newStatus) {
            orders[index].paymentStatus = newStatus;
            saveToStorage();
            renderOrders();
        }

        function toggleModal(show, index = null) {
            const modal = document.getElementById('order-modal');
            const form = document.getElementById('order-form');
            document.getElementById('edit-index').value = index !== null ? index : '';
            document.getElementById('modal-title').innerText = index !== null ? 'Modify Order File' : 'Create New Hauling Order';
            
            form.reset();
            document.getElementById('vehicles-container').innerHTML = '';

            if (show) {
                if (index !== null) {
                    const o = orders[index];
                    document.getElementById('form-id').value = o.orderNumber;
                    document.getElementById('form-broker').value = o.brokerName;
                    document.getElementById('form-pickup').value = o.pickup;
                    document.getElementById('form-drop').value = o.drop;
                    document.getElementById('form-pickup-time').value = o.pickupTime || '';
                    document.getElementById('form-delivery-time').value = o.deliveryTime || '';
                    document.getElementById('form-rate').value = o.rate;
                    document.getElementById('form-order-status').value = o.orderStatus;
                    document.getElementById('form-payment-status').value = o.paymentStatus;
                    o.vehicles.forEach(v => addVehicleInput(v.ymm, v.operable));
                } else {
                    addVehicleInput(); // Default to one vehicle empty row input line item
                }
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
            lucide.createIcons();
        }

        function addVehicleInput(ymm = '', operable = true) {
            const container = document.getElementById('vehicles-container');
            const rowId = 'v-row-' + Date.now() + Math.random().toString(36).substr(2, 4);
            const div = document.createElement('div');
            div.id = rowId;
            div.className = "flex items-center gap-3 bg-slate-800/60 p-3 rounded-xl border border-slate-700/40";
            div.innerHTML = `
                <div class="flex-1">
                    <input type="text" placeholder="Year, Make, Model (e.g., 2024 Toyota RAV4)" value="${ymm}" required class="vehicle-ymm w-full bg-slate-900 border border-slate-700/60 rounded-lg px-3 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                </div>
                <div class="flex items-center gap-2">
                    <select class="vehicle-op bg-slate-900 border border-slate-700/60 rounded-lg px-2 py-2 text-sm text-slate-300 focus:outline-none">
                        <option value="true" ${operable ? 'selected' : ''}>Runs</option>
                        <option value="false" ${!operable ? 'selected' : ''}>Inop</option>
                    </select>
                </div>
                <button type="button" onclick="document.getElementById('${rowId}').remove()" class="text-slate-500 hover:text-rose-400 p-1 transition-colors cursor-pointer"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
            `;
            container.appendChild(div);
            lucide.createIcons();
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            const index = document.getElementById('edit-index').value;
            
            // Re-aggregate and build sub-array rows for vehicles input block
            const vehicleRows = document.getElementById('vehicles-container').children;
            const vehiclesList = [];
            for (let row of vehicleRows) {
                const ymm = row.querySelector('.vehicle-ymm').value;
                const operable = row.querySelector('.vehicle-op').value === 'true';
                if(ymm.trim() !== "") vehiclesList.push({ ymm, operable });
            }

            if(vehiclesList.length === 0) {
                alert("An order manifest must contain at least a single vehicle cargo tracking record.");
                return;
            }

            const payload = {
                orderNumber: document.getElementById('form-id').value.trim(),
                brokerName: document.getElementById('form-broker').value.trim(),
                pickup: document.getElementById('form-pickup').value.trim(),
                drop: document.getElementById('form-drop').value.trim(),
                pickupTime: document.getElementById('form-pickup-time').value,
                deliveryTime: document.getElementById('form-delivery-time').value,
                rate: parseFloat(document.getElementById('form-rate').value) || 0,
                orderStatus: document.getElementById('form-order-status').value,
                paymentStatus: document.getElementById('form-payment-status').value,
                vehicles: vehiclesList
            };

            if (index !== '') {
                orders[index] = payload;
            } else {
                orders.unshift(payload);
            }

            saveToStorage();
            toggleModal(false);
            renderOrders();
        }

        function deleteOrder(index) {
            if(confirm("Confirm action: permanently delete this order tracking file row record?")) {
                orders.splice(index, 1);
                saveToStorage();
                renderOrders();
            }
        }

        function updateMetrics() {
            let active = 0, deliveredUnpaid = 0, openBalance = 0, totalCars = 0;

            orders.forEach(o => {
                totalCars += o.vehicles.length;
                if(o.orderStatus === 'Assigned' || o.orderStatus === 'Picked Up') active++;
                if(o.orderStatus === 'Delivered' && o.paymentStatus === 'Unpaid') deliveredUnpaid++;
                if(o.paymentStatus === 'Unpaid') openBalance += o.rate;
            });

            document.getElementById('stat-active').innerText = active;
            document.getElementById('stat-delivered').innerText = deliveredUnpaid;
            document.getElementById('stat-balance').innerText = `$${openBalance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById('stat-vehicles').innerText = totalCars;
        }

        function formatTimestamp(datetimeStr) {
            if (!datetimeStr) return '<span class="text-slate-500 italic">Pending</span>';
            const dt = new Date(datetimeStr);
            return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + 
                   dt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        }

        function renderOrders() {
            const tbody = document.getElementById('orders-tbody');
            const haulFilter = document.getElementById('filter-status').value;
            const paymentFilter = document.getElementById('filter-payment').value;
            tbody.innerHTML = '';
            
            let displayCount = 0;

            orders.forEach((o, index) => {
                if (haulFilter !== 'All' && o.orderStatus !== haulFilter) return;
                if (paymentFilter !== 'All' && o.paymentStatus !== paymentFilter) return;
                displayCount++;

                const statusStyles = {
                    'Assigned': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
                    'Picked Up': 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
                    'Delivered': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
                    'Cancelled': 'bg-slate-500/10 text-slate-400 border-slate-500/20'
                }[o.orderStatus];

                const payStyles = {
                    'Unpaid': 'bg-rose-500/10 text-rose-400 border-rose-500/30',
                    'Paid': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
                    'Factored': 'bg-purple-500/10 text-purple-400 border-purple-500/30'
                }[o.paymentStatus];

                const vehicleBadges = o.vehicles.map(v => `
                    <div class="flex items-center gap-1.5 text-xs bg-slate-800/80 px-2 py-1 rounded border border-slate-700/50 text-slate-300">
                        <span class="w-1.5 h-1.5 rounded-full ${v.operable ? 'bg-emerald-500' : 'bg-rose-500'}"></span>
                        ${v.ymm}
                    </div>
                `).join('');

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/20 transition-colors";
                tr.innerHTML = `
                    <td class="p-4 whitespace-nowrap">
                        <div class="font-semibold text-white tracking-wide">${o.orderNumber}</div>
                        <div class="text-xs text-slate-400 font-medium">${o.brokerName}</div>
                    </td>
                    <td class="p-4">
                        <div class="flex flex-col text-xs space-y-0.5 font-medium">
                            <span class="text-slate-300 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span> ${o.pickup}</span>
                            <span class="text-slate-400 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span> ${o.drop}</span>
                        </div>
                    </td>
                    <td class="p-4 text-xs font-medium whitespace-nowrap">
                        <div class="space-y-1">
                            <div class="text-slate-300 flex items-center gap-1">
                                <i data-lucide="arrow-up-right" class="w-3.5 h-3.5 text-indigo-400"></i> ${formatTimestamp(o.pickupTime)}
                            </div>
                            <div class="text-slate-400 flex items-center gap-1">
                                <i data-lucide="arrow-down-left" class="w-3.5 h-3.5 text-emerald-400"></i> ${formatTimestamp(o.deliveryTime)}
                            </div>
                        </div>
                    </td>
                    <td class="p-4"><div class="flex flex-wrap gap-1 max-w-xs">${vehicleBadges}</div></td>
                    <td class="p-4 font-bold text-slate-200 whitespace-nowrap">$${o.rate.toFixed(2)}</td>
                    <td class="p-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold border ${statusStyles}">${o.orderStatus}</span>
                    </td>
                    <td class="p-4 whitespace-nowrap">
                        <select onchange="quickUpdatePaymentStatus(${index}, this.value)" class="px-2.5 py-1 rounded-full text-xs font-semibold border ${payStyles} focus:outline-none cursor-pointer bg-slate-900">
                            <option value="Unpaid" class="bg-slate-900 text-rose-400" ${o.paymentStatus === 'Unpaid' ? 'selected' : ''}>Unpaid</option>
                            <option value="Paid" class="bg-slate-900 text-emerald-400" ${o.paymentStatus === 'Paid' ? 'selected' : ''}>Paid</option>
                            <option value="Factored" class="bg-slate-900 text-purple-400" ${o.paymentStatus === 'Factored' ? 'selected' : ''}>Factored</option>
                        </select>
                    </td>
                    <td class="p-4 text-right whitespace-nowrap">
                        <div class="flex items-center justify-end gap-1.5">
                            <button onclick="toggleModal(true, ${index})" class="p-1.5 text-slate-400 hover:text-indigo-400 bg-slate-800/40 hover:bg-slate-800 rounded-lg transition-colors border border-slate-700/30 cursor-pointer" title="Edit Record"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                            <button onclick="deleteOrder(${index})" class="p-1.5 text-slate-400 hover:text-rose-400 bg-slate-800/40 hover:bg-slate-800 rounded-lg transition-colors border border-slate-700/30 cursor-pointer" title="Delete"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('empty-state').classList.toggle('hidden', displayCount > 0);
            updateMetrics();
            lucide.createIcons();
        }
    </script>
</body>
</html>
